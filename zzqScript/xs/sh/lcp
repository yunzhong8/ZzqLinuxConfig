#!/bin/bash

# Script to upload a file using lftp with specified or default server and destination.
# Partially generated by ChatGPT

# Default values
default_server="$(whoami)@172.18.10.1"  # Default server using the current user's name
default_dest="."  # Default destination directory (server's home directory)

# Read command line arguments
src="$1"
dest="${2:-$default_dest}"
server="${3:-$default_server}"

echo Calling lftp to copy $src to $server:$dest

# The lftp command
lftp -e "set ssl:verify-certificate no; cd $dest; put $src; exit" $server
